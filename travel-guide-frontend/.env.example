# Copie para .env.local. Valores em Supabase → Project Settings → API Keys.
# Só a chave publishable (sb_publishable_...). Nunca a secret/service_role aqui.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional: vídeos nos detalhes de uma ideia (YouTube Data API v3, grátis, sem cartão).
# Só no servidor: nunca com NEXT_PUBLIC_. Sem ela, o app mostra só o link de busca no YouTube.
YOUTUBE_API_KEY=
